# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
NODE_ENV=development

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES=12h

# SQL Server (BMC) - sama seperti application/config/database.php
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=BMC
DB_USER=sa
DB_PASSWORD=change-me
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# WA gateway (dipakai generate_cuti, infoCutiGroupHeadDeptHead, employeeTempConfirmAct)
WA_BASE_URL=http://localhost/api/send.php
WA_TOKEN=change-me

# Upload (foto karyawan, warning letter)
UPLOAD_DIR=./uploads
